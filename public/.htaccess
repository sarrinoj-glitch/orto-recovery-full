# Статический сайт «Орто-Рекавери» на хостинге REG.RU (Apache)
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

RewriteEngine On

# www.ortorecovery.ru → ortorecovery.ru
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Старые адреса WordPress → новые страницы (сохраняем позиции в поиске)
RewriteRule ^prp-terapiya-sustavov-v-mahachkale-czentr-orto-rekaveri/?$ /uslugi/prp/ [L,R=301]
RewriteRule ^konsultacziya-ortopeda-travmatologa-v-mahachkale/?$ /uslugi/koleno/ [L,R=301]
RewriteRule ^(feed|comments/feed)/?$ / [L,R=301]
RewriteRule ^(page-sitemap|post-sitemap|sitemap_index)\.xml$ /sitemap.xml [L,R=301]
RewriteRule ^wp-(admin|login\.php|content|includes)(/.*)?$ / [L,R=301]

# Кэш: картинки и видео — на 30 дней; скрипты и стили Next.js с хэшем в имени — на год; страницы — всегда свежие
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
